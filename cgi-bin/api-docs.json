{
  "openapi": "3.0.3",
  "info": {
    "title": "LeoBBS X REST API",
    "description": "REST API for LeoBBS X forum system. Provides JSON endpoints to access forum data, topics, user profiles, and authentication.",
    "version": "1.0.0",
    "contact": {
      "name": "LeoBBS X",
      "url": "http://www.LeoBBS.com/"
    }
  },
  "servers": [
    {
      "url": "/cgi-bin",
      "description": "Default CGI server"
    }
  ],
  "paths": {
    "/api.cgi": {
      "get": {
        "summary": "API Info",
        "description": "Returns API version and available endpoints",
        "responses": {
          "200": {
            "description": "API information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "version": { "type": "string" },
                    "endpoints": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=forums": {
      "get": {
        "summary": "List Forums",
        "description": "Get all visible forums with their statistics",
        "operationId": "listForums",
        "tags": ["Forums"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["forums"] }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Forum ID to get single forum detail",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Forum list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "forums": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Forum" }
                    },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=topics": {
      "get": {
        "summary": "List Topics",
        "description": "Get topics in a forum with pagination",
        "operationId": "listTopics",
        "tags": ["Topics"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["topics"] }
          },
          {
            "name": "forum",
            "in": "query",
            "required": true,
            "description": "Forum ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default: 1)",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page (default: 20, max: 50)",
            "schema": { "type": "integer", "default": 20, "maximum": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Topic list with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "forum_id": { "type": "integer" },
                    "topics": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Topic" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=topic": {
      "get": {
        "summary": "Get Topic Detail",
        "description": "Get a topic's posts with pagination",
        "operationId": "getTopicDetail",
        "tags": ["Topics"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["topic"] }
          },
          {
            "name": "forum",
            "in": "query",
            "required": true,
            "description": "Forum ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Topic ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20, "maximum": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Topic posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "forum_id": { "type": "integer" },
                    "topic_id": { "type": "integer" },
                    "posts": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Post" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=auth": {
      "post": {
        "summary": "Authentication",
        "description": "Login to get API token, or verify existing token",
        "operationId": "authenticate",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["auth"] }
          },
          {
            "name": "action",
            "in": "query",
            "required": true,
            "description": "Auth action: login or verify",
            "schema": { "type": "string", "enum": ["login", "verify"] }
          }
        ],
        "requestBody": {
          "description": "Login credentials (for action=login)",
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "description": "Username" },
                  "password": { "type": "string", "description": "Password" }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "token": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/UserBasic" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=user": {
      "get": {
        "summary": "Get User Profile",
        "description": "Get public profile information for a user",
        "operationId": "getUserProfile",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["user"] }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Username to lookup",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserProfile" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=search": {
      "get": {
        "summary": "Search Topics",
        "description": "Search topics by keyword in title, description, or author",
        "operationId": "searchTopics",
        "tags": ["Search"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["search"] }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search keyword",
            "schema": { "type": "string" }
          },
          {
            "name": "forum",
            "in": "query",
            "required": false,
            "description": "Limit search to specific forum ID",
            "schema": { "type": "integer" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string" },
                    "results": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Topic" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=stats": {
      "get": {
        "summary": "Board Statistics",
        "description": "Get overall board statistics",
        "operationId": "getBoardStats",
        "tags": ["Board"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["stats"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Board statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "board_name": { "type": "string" },
                    "board_description": { "type": "string" },
                    "board_url": { "type": "string" },
                    "total_members": { "type": "integer" },
                    "total_posts": { "type": "integer" },
                    "total_topics": { "type": "integer" },
                    "total_forums": { "type": "integer" },
                    "latest_member": { "type": "string" },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api.cgi?endpoint=online": {
      "get": {
        "summary": "Online Users",
        "description": "Get currently online users",
        "operationId": "getOnlineUsers",
        "tags": ["Board"],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["online"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Online users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "members": { "type": "integer" },
                    "guests": { "type": "integer" },
                    "users": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "location": { "type": "string" },
                          "activity": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Forum": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "moderator": { "type": "string" },
          "category": { "type": "string" },
          "category_place": { "type": "string" },
          "is_child": { "type": "integer", "description": "1 if sub-forum, 0 if top-level" },
          "parent_id": { "type": "integer" },
          "private": { "type": "boolean" },
          "threads": { "type": "integer" },
          "posts": { "type": "integer" },
          "today_posts": { "type": "integer" },
          "last_poster": { "type": "string" },
          "last_post_time": { "type": "string" }
        }
      },
      "Topic": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "forum_id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "state": { "type": "string" },
          "locked": { "type": "boolean" },
          "replies": { "type": "integer" },
          "views": { "type": "integer" },
          "author": { "type": "string" },
          "created_at": { "type": "string" },
          "last_poster": { "type": "string" },
          "last_post_at": { "type": "string" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "index": { "type": "integer" },
          "author": { "type": "string" },
          "date": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "signature": { "type": "string" },
          "icon": { "type": "string" }
        }
      },
      "UserBasic": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "role": { "type": "string" },
          "posts": { "type": "integer" },
          "email": { "type": "string" },
          "avatar": { "type": "string" },
          "joined": { "type": "string" },
          "rating": { "type": "integer" }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "role": { "type": "string" },
          "posts": { "type": "integer" },
          "email": { "type": "string", "nullable": true },
          "homepage": { "type": "string" },
          "qq": { "type": "string" },
          "icq": { "type": "string" },
          "location": { "type": "string" },
          "interests": { "type": "string" },
          "joined": { "type": "string" },
          "last_post": { "type": "string" },
          "avatar": { "type": "string" },
          "personal_avatar": { "type": "string" },
          "rating": { "type": "integer" },
          "visits": { "type": "integer" },
          "sex": { "type": "string" },
          "signature": { "type": "string" },
          "online_time": { "type": "integer" },
          "jifen": { "type": "integer" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "total_pages": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "integer" }
        }
      }
    },
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Token",
        "description": "Token obtained from auth endpoint (Base64 encoded username:password_hash)"
      }
    }
  }
}
